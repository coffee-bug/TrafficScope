{
  "manifest_version": 3,
  "name": "TrafficScope Site Helper",
  "version": "1.0.0",
  "description": "Tells TrafficScope which website each request belongs to. Hostnames only — never URLs, paths or query strings.",
  "key": "",
  "permissions": [
    "webRequest",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
